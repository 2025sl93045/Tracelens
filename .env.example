# Copy to .env and adjust as needed. NEVER commit a real .env.

# --- PostgreSQL ---
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=tracelens
POSTGRES_DB=tracelens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Core API (serves the frontend) ---
API_PORT=4000
# Secret used to sign dashboard JWTs. Use a long random value in real deployments.
JWT_SECRET=change-me-in-production

# --- Ingestion API ---
INGESTION_PORT=4001
# API key that demo services / collectors use to push telemetry.
INGESTION_API_KEY=dev-ingest-key

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000
